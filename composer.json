{
    "name": "schachbulle/contao-wertungsportal-bundle",
    "type": "contao-bundle",
    "description": "Bindet das Wertungsportal des Deutschen Schachbundes über dessen REST-Schnittstelle in Contao ein und löst die ältere DeWIS-SOAP-Schnittstelle ab.",
    "keywords": [
        "contao",
        "schach",
        "dwz",
        "wertungszahl",
        "wertungsportal",
        "schachbund"
    ],
    "homepage": "https://github.com/Samson1964/contao-wertungsportal-bundle",
    "license": "LGPL-3.0-or-later",
    "authors": [
        {
            "name": "Frank Binding",
            "homepage": "https://www.schachbulle.de/"
        }
    ],
    "require": {
        "php": "^7.4 || ^8.0",
        "contao/core-bundle": "^4.13 || ^5.0",
        "schachbulle/contao-helper-bundle": "^1.8.10 || ^2.0",
        "schachbulle/contao-flaggen-bundle": "*",
        "menatwork/contao-multicolumnwizard-bundle": "^3.6 || ^4.0"
    },
    "conflict": {
        "contao/core": "*",
        "contao/manager-plugin": "<2.0 || >=3.0"
    },
    "require-dev": {
        "contao/manager-plugin": "^2.0",
        "phpunit/phpunit": "^9.5"
    },
    "extra": {
        "contao-manager-plugin": "Schachbulle\\ContaoWertungsportalBundle\\ContaoManager\\Plugin"
    },
    "autoload": {
        "psr-4": {
            "Schachbulle\\ContaoWertungsportalBundle\\": "src/"
        }
    },
    "support": {
        "issues": "https://github.com/Samson1964/contao-wertungsportal-bundle/issues",
        "source": "https://github.com/Samson1964/contao-wertungsportal-bundle"
    }
}
