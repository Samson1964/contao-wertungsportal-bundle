<?php
/**
 * Registrierung für die Vereinslisten-Schnittstelle
 *
 * Erwartete Variablen:
 *   formId        Kennung des Formulars (FORM_SUBMIT)
 *   action        Ziel-URL des Formulars
 *   adresse       Vollständige Adresse der Schnittstelle
 *   eingaben      vkz, vorname, nachname, email (Wiedervorlage nach Fehlern)
 *   fehler        Liste der Fehlermeldungen
 *   bestaetigung  Text nach erfolgreicher Anforderung (dann kein Formular)
 */

// Wie in den übrigen Ausgaben des Bundles: das eigene Stylesheet anmelden.
// Ohne diese Zeile UND ohne die Klasse „dewis" am Rahmen unten greift keine
// einzige Regel aus default.css — das Formular stand vorher ungestylt da
$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/default.css';
?>
<div class="<?= $this->class ?> dewis wp-token block"<?= $this->cssID ?>>

	<?php if($this->headline): ?>
		<<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
	<?php endif; ?>

	<?php if($this->bestaetigung): ?>

		<p class="wp-bestaetigung" role="status"><?= $this->bestaetigung ?></p>
		<p class="tl_help tl_tip">In der E-Mail finden Sie neben dem Schlüssel ein PHP-Beispielskript,
			das sich unverändert übernehmen lässt. Kommt die Nachricht nicht an, prüfen Sie bitte
			auch den Spam-Ordner.</p>

	<?php else: ?>

		<p>Mit einem Zugangsschlüssel können Sie die Mitgliederliste Ihres Vereins als JSON
			abrufen und auf Ihrer eigenen Website ausgeben. Der Schlüssel gilt für genau einen
			Verein und wird Ihnen per E-Mail zugeschickt.</p>

		<div class="wp-suche">
			<form action="<?= $this->action ?>" method="post">
				<input type="hidden" name="FORM_SUBMIT" value="<?= $this->formId ?>">
				<input type="hidden" name="REQUEST_TOKEN" value="<?= REQUEST_TOKEN ?>">

				<div class="wp-suche-block wp-suche-block--offen">

					<?php
						// Zwei Spalten: links die Beschriftungen, rechts die Felder.
						// Jede Zeile besteht aus genau zwei Rasterkindern, damit
						// Beschriftungen und Eingaben jeweils bündig untereinander
						// stehen — deshalb sitzen Feld und Hilfetext zusammen in
						// einem Behälter
						$felder = array
						(
							array('name' => 'vkz',      'typ' => 'text',  'titel' => 'Vereinskennziffer (VKZ)', 'max' => 5,   'klasse' => 'wp-input--kurz',
							      'hilfe' => 'Fünf Zeichen, zum Beispiel 30052. Sie finden die Kennziffer auf der Vereinsseite.'),
							array('name' => 'vorname',  'typ' => 'text',  'titel' => 'Vorname',                 'max' => 128, 'klasse' => '', 'hilfe' => ''),
							array('name' => 'nachname', 'typ' => 'text',  'titel' => 'Nachname',                'max' => 128, 'klasse' => '', 'hilfe' => ''),
							array('name' => 'email',    'typ' => 'email', 'titel' => 'E-Mail-Adresse',          'max' => 255, 'klasse' => '',
							      'hilfe' => 'An diese Adresse wird der Zugangsschlüssel geschickt.'),
						);
					?>

					<div class="wp-token-felder">
						<?php foreach($felder as $feld): ?>
							<label class="wp-label" for="ctrl_<?= $feld['name'] ?>"><?= $feld['titel'] ?></label>
							<div class="wp-eingabe">
								<input type="<?= $feld['typ'] ?>" class="tl_input_text wp-input <?= $feld['klasse'] ?>"
									id="ctrl_<?= $feld['name'] ?>" name="<?= $feld['name'] ?>" maxlength="<?= $feld['max'] ?>"
									value="<?= \Contao\StringUtil::specialchars($this->eingaben[$feld['name']]) ?>" required>
								<?php if($feld['hilfe']): ?>
									<p class="tl_help tl_tip"><?= $feld['hilfe'] ?></p>
								<?php endif; ?>
							</div>
						<?php endforeach; ?>
					</div>

					<?php // Honigtopf gegen selbsttätig ausfüllende Skripte — für Besucher unsichtbar ?>
					<div style="position:absolute;left:-9999px" aria-hidden="true">
						<label for="ctrl_wp_homepage">Homepage</label>
						<input type="text" id="ctrl_wp_homepage" name="wp_homepage" value="" tabindex="-1" autocomplete="off">
					</div>

					<?php if(count($this->fehler)): ?>
						<div class="wp-fehler" role="alert">
							<?php foreach($this->fehler as $meldung): ?>
								<p><?= $meldung ?></p>
							<?php endforeach; ?>
						</div>
					<?php endif; ?>

					<div class="wp-suche-aktionen">
						<button type="submit" class="tl_submit wp-button">Zugangsschlüssel anfordern</button>
					</div>

				</div>
			</form>
		</div>

		<h3>Wie der Abruf funktioniert</h3>
		<p>Die Schnittstelle liefert die Mitgliederliste als JSON:</p>
		<p><code class="wp-adresse"><?= \Contao\StringUtil::specialchars($this->adresse) ?>?token=<em>SCHLÜSSEL</em>&amp;vkz=<em>VKZ</em></code></p>
		<p class="tl_help tl_tip">Bitte rufen Sie die Liste höchstens einmal am Tag ab — die Daten ändern
			sich seltener, und die Schnittstelle liefert ohnehin einen zwischengespeicherten Stand.
			Behandeln Sie den Schlüssel wie ein Kennwort: Er gehört nicht in Javascript oder in
			anderen öffentlich lesbaren Quelltext.</p>

	<?php endif; ?>

</div>
