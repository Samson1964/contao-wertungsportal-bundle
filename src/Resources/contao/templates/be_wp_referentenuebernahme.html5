<?php
/**
 * Backend-Template: Referenten aus der Adressverwaltung übernehmen (ab 1.51.0)
 *
 * Vorschau der Übernahme (Classes\Referentenuebernahme) mit dem Knopf, der
 * sie ausführt. FLUCHTLINIE wie be_wp_cache: alles 15 px vom Rand des
 * Inhaltsbereichs, kein tl_listing_container (Klassen wp-werkzeug… in der
 * backend.css des Bundles).
 */
$e = static function ($wert) {
	return \Contao\StringUtil::specialchars((string) $wert);
};

$plan = $this->plan;
$verbaende = $this->verbaende;

// Kennziffern mit Namen, so wie sie im Feld „Zuständig für" stehen
$verbandstext = static function (array $liste) use ($verbaende, $e) {
	$texte = array();

	foreach($liste as $vkz)
	{
		$texte[] = $e($verbaende[$vkz] ?? $vkz);
	}

	return implode('<br>', $texte);
};
?>
<div id="tl_buttons">
	<a href="<?= \Contao\StringUtil::ampersand($this->zurueck) ?>" class="header_back" title="Zurück zu den Referenten" accesskey="b">Zurück</a>
</div>

<h2 class="sub_headline wp-werkzeug-kopf">Referenten aus der Adressverwaltung übernehmen</h2>

<div class="wp-werkzeug">

	<p class="tl_help wp-werkzeug-text">
		Wer in der Adressverwaltung als Wertungsreferent eines Verbandes eingetragen ist,
		wird hier als Referent angelegt: verknüpft mit seiner Adresse, aus der Name, E-Mail,
		Telefon und Anschrift künftig kommen, und mit den Verbänden, für die er dort
		zuständig ist. Danach wird die Zuständigkeit nur noch hier gepflegt.
		Adressen, die schon einem Referenten zugeordnet sind, bleiben unberührt — ein
		zweiter Lauf legt niemanden doppelt an.
	</p>

	<?php if(count($plan['neu'])): ?>

		<form action="<?= $e($this->aktion) ?>" method="post">
			<input type="hidden" name="FORM_SUBMIT" value="<?= $e($this->formular) ?>">
			<input type="hidden" name="REQUEST_TOKEN" value="<?= $e($this->token) ?>">

			<div class="tl_formbody_edit">
				<div class="tl_tbox cf">
					<div class="widget clr">
						<div class="tl_checkbox_single_container">
							<input type="checkbox" name="veroeffentlichen" id="ctrl_veroeffentlichen" value="1" class="tl_checkbox">
							<label for="ctrl_veroeffentlichen">Übernommene Referenten gleich veröffentlichen</label>
						</div>
						<p class="tl_help tl_tip">Veröffentlichte Referenten stehen in der Referentenliste und unter
							den Ranglisten und bekommen die Reklamationen zu ihren Verbänden. Ohne Haken bleiben sie
							unsichtbar, bis sie hier einzeln oder über „Mehrere bearbeiten“ veröffentlicht werden.</p>
					</div>
				</div>
			</div>

			<div class="tl_submit_container">
				<button type="submit" class="tl_submit"
					onclick="return confirm('<?= count($plan['neu']) ?> Referenten jetzt anlegen?')"><?= count($plan['neu']) ?> Referenten übernehmen</button>
			</div>
		</form>

	<?php else: ?>

		<p class="tl_info wp-werkzeug-meldung">Es gibt nichts mehr zu übernehmen: Alle Wertungsreferenten der
			Adressverwaltung, die einem Verband des Wertungsportals zugeordnet werden können, sind schon angelegt.</p>

	<?php endif; ?>

	<div class="wp-werkzeug-ergebnis">

		<?php if(count($plan['neu'])): ?>
			<h3 class="wp-stat-ueberschrift">Werden angelegt: <?= count($plan['neu']) ?></h3>
			<div class="wp-stat-scroll">
			<table class="tl_listing wp-stat-tabelle">
				<thead>
					<tr>
						<th>Name (Adressverwaltung)</th>
						<th>Zuständig für</th>
						<th>Nicht übernommen</th>
					</tr>
				</thead>
				<tbody>
					<?php foreach($plan['neu'] as $eintrag): ?>
						<tr>
							<td><?= $e($eintrag['name']) ?></td>
							<td><?= $verbandstext($eintrag['verbaende']) ?></td>
							<td<?= count($eintrag['unbekannt']) ? ' class="tl_red"' : '' ?>><?= $e(implode(', ', $eintrag['unbekannt'])) ?></td>
						</tr>
					<?php endforeach; ?>
				</tbody>
			</table>
			</div>
		<?php endif; ?>

		<?php if(count($plan['ohneVerband'])): ?>
			<h3 class="wp-stat-ueberschrift">Ohne passenden Verband — bitte von Hand anlegen: <?= count($plan['ohneVerband']) ?></h3>
			<p class="tl_help">Die Schlüssel dieser Personen gibt es im Wertungsportal nicht. Den Referenten neu
				anlegen, die Adresse zuordnen und den richtigen Verband wählen.</p>
			<ul class="wp-uebernahme-liste">
				<?php foreach($plan['ohneVerband'] as $eintrag): ?>
					<li><?= $e($eintrag['name']) ?> <span class="tl_red">(<?= $e(implode(', ', $eintrag['unbekannt'])) ?>)</span></li>
				<?php endforeach; ?>
			</ul>
		<?php endif; ?>

		<?php if(count($plan['unbekannt'])): ?>
			<h3 class="wp-stat-ueberschrift">Schlüssel ohne Gegenstück im Wertungsportal</h3>
			<p class="tl_help">
				<?php foreach($plan['unbekannt'] as $vkz => $anzahl): ?>
					<?= $e($vkz) ?> (<?= $anzahl ?>&nbsp;<?= $anzahl === 1 ? 'Person' : 'Personen' ?>)<br>
				<?php endforeach; ?>
			</p>
		<?php endif; ?>

		<?php if(count($plan['vorhanden'])): ?>
			<h3 class="wp-stat-ueberschrift">Schon als Referent vorhanden: <?= count($plan['vorhanden']) ?></h3>
			<p class="tl_help"><?= $e(implode(', ', array_column($plan['vorhanden'], 'name'))) ?></p>
		<?php endif; ?>

		<?php if($plan['inaktiv']): ?>
			<p class="tl_help">Nicht berücksichtigt: <?= $plan['inaktiv'] ?> inaktive Adressen mit Wertungsreferat.</p>
		<?php endif; ?>

	</div>

</div>
