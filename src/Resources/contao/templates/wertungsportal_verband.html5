<!-- indexer::stop -->

<?php
	$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/default.css';
	$GLOBALS['TL_CSS'][] = 'bundles/flag-icon-css/css/flag-icon.min.css|static';
?>

<div class="<?php echo $this->class; ?> dewis block"<?php echo $this->cssID; ?> style="<?php if ($this->margin): ?><?php echo trim($this->margin); ?><?php endif; ?> <?php if ($this->style): ?><?php echo $this->style; ?><?php endif; ?>">

	<?php if($this->headline): ?>
		<<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
	<?php endif; ?> 

	<div class="dewislinks noprint">
		<ul>
		<?php foreach($this->navigation as $d): ?>
			<?= $d ?>
		<?php endforeach; ?>
		</ul>
	</div>

	<?php if($this->subHeadline): ?>
		<<?= $this->shl ?>><?= $this->subHeadline ?></<?= $this->shl ?>>
	<?php endif; ?> 

	<?php if($this->searchform): ?>
		<?php $this->insert('wertungsportal_form_verbandsliste', array
		(
			'action'       => \Schachbulle\ContaoWertungsportalBundle\Helper\Helper::getVerbandseiteUrl().'/'.$this->zps.'.html',
			'sel_toplist'  => $this->sel_toplist,
			'sel_sex'      => $this->sel_sex,
			'sel_german'   => $this->sel_german,
			'sel_age_from' => $this->sel_age_from,
			'sel_age_to'   => $this->sel_age_to,
			'fehler'       => false,
			'eingeklappt'  => false,
		)); ?>
	<?php endif; ?>


	<?php if($this->sichtbar): ?>

		<?php
			// Spaltensortierung: Parser und Initialisierung stehen in
			// wertungsportal_sort.js, die Spaltenbehandlung steuert data-sort.
			// Die frühere Fassung stand hier inline und ordnete die Parser über
			// feste Spaltennummern zu (2, 3, 5) — die stimmten nur, solange
			// Geschlecht und Status eingeblendet waren; sonst landeten sie auf
			// den falschen Spalten
			$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/tablesorter.css';
			$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/jquery.tablesorter.min.js';
			$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/wertungsportal_sort.js';
		?>

		<div class="table_responsiv">
			<table class="body tablesorter">
				<thead>
					<tr class="row_0">
						<th class="col_1 right-line" data-sort="zahl">Pl.</th>
						<th class="col_2 right-line">Spielername</th>
						<?php if(!$GLOBALS['TL_CONFIG']['wertungsportal_geschlecht_ausblenden']): ?><th class="col_3 right-line">Geschl.</th><?php endif; ?>
						<th class="col_4 right-line" data-sort="woche">Letzte<br>Ausw.</th>
						<th class="col_5 right-line" data-sort="zahl">DWZ</th>
						<th class="col_6 right-line" data-sort="zahl">Elo</th>
						<th class="col_7 right-line" data-sort="titel">FIDE-<br>Titel</th>
						<th class="col_10 right-line">FIDE-<br>Nation</th>
						<?php if(!$GLOBALS['TL_CONFIG']['wertungsportal_passive_ausblenden']): ?><th class="col_8 right-line">Sta-<br>tus</th><?php endif; ?>
						<th class="col_9">Verein</th>
					</tr>
				</thead>
				<tbody>
					<?php $row = 1; ?>
					<?php if($this->daten): ?>
						<?php $x = 0; ?>
						<?php foreach($this->daten as $d): ?>
							<?php $x++; $class = ($x < count($this->daten)) ? ' bottom-line' : ''; ?>
							<tr class="row_<?= $row ?>">
								<td class="col_1 right-line<?= $class ?> align-right"><?= $d['Platz'] ?>.</td>
								<td class="col_2 right-line<?= $class ?>"><?= $d['Spielername'] ?></td>
								<?php if(!$GLOBALS['TL_CONFIG']['wertungsportal_geschlecht_ausblenden']): ?><td class="col_3 right-line<?= $class ?>"><?= $d['Geschlecht'] ?></td><?php endif; ?>
								<td class="col_4 right-line<?= $class ?>"><?= $d['KW'] ?></td>
								<td class="col_5 right-line<?= $class ?>"><?= $d['DWZ'] ?></td>
								<td class="col_6 right-line<?= $class ?>"><?= $d['Elo'] ?></td>
								<td class="col_7 right-line<?= $class ?>"><?= $d['FIDE-Titel'] ?></td>
								<td class="col_10 right-line<?= $class ?>"><?= $d['FIDE-Nation'] ?></td>
								<?php if(!$GLOBALS['TL_CONFIG']['wertungsportal_passive_ausblenden']): ?><td class="col_8 right-line<?= $class ?>"><?= $d['Status'] ?></td><?php endif; ?>
								<td class="col_9<?= $class ?>"><?= $d['Verein'] ?></td>
							</tr>
							<?php $row++; ?>
						<?php endforeach; ?>
					<?php endif; ?>
				</tbody>
			</table>
		</div>

		<?php if($this->verbaende): ?>
			<div class="table_responsiv">
				<table class="body">
					<thead>
						<tr>
							<th>Verbandszugehörigkeiten</th>
						</tr>
					</thead>
					<tbody>
					<?php $x = 0; ?>
					<?php foreach($this->verbaende as $d): ?>
						<?php $x++; $class = ($x < count($this->verbaende)) ? ' bottom-line' : ''; ?>
						<tr>
							<td class="<?= $d['ebene'] ?><?= $class ?>"><?= $d['url'] ?></td>
						</tr>
					<?php endforeach; ?>
					</tbody>
				</table>
			</div>
		<?php endif; ?>

		<div class="table_responsiv">
			<table class="body">
				<thead>
					<tr>
						<th>Zuständiger Wertungsreferent</th>
					</tr>
				</thead>
				<tbody>
					<tr>
						<td><?= $this->referent ?></td>
					</tr>
				</tbody>
			</table>
		</div>

	<?php else: ?>
	
		<?php if($this->verbaende): ?>
			<div class="table_responsiv">
				<table class="body">
					<thead>
						<tr>
							<th>Verbandszugehörigkeiten</th>
						</tr>
					</thead>
					<tbody>
					<?php $x = 0; ?>
					<?php foreach($this->verbaende as $d): ?>
						<?php $x++; $class = ($x < count($this->verbaende)) ? ' bottom-line' : ''; ?>
						<tr>
							<td class="<?= $d['ebene'] ?><?= $class ?>"><?= $d['url'] ?></td>
						</tr>
					<?php endforeach; ?>
					</tbody>
				</table>
			</div>
		<?php endif; ?>

	<?php endif; ?>

	<?= $this->infobox ?>

<?php if($this->hinweis): ?>
	<?= $this->registrierung ?>
<?php endif; ?> 

</div>
