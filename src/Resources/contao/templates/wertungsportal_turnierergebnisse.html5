<?php
/**
 * Einfaches Frontend-Modul-Template für Contao 4
 *
 * Ablageort: templates/mod_myModule.html5
 *
 * Verfügbare Standard-Variablen:
 *   $this->headline   Überschrift (falls im Modul gesetzt)
 *   $this->hl         HTML-Tag der Überschrift (h1–h6)
 *   $this->class      CSS-Klasse(n) des Moduls
 *   $this->cssID      id-Attribut des Moduls
 *
 * Eigene Variablen werden in der Modulklasse per
 *   $this->Template->foo = 'bar';
 * bereitgestellt.
 */
?>
<?php
	$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/default.css';
	$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/chosen.css';
	$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/chosen.jquery.min.js';
?>
<script>
(function($)
{
	$(document).ready(function(){
		$(".tl_chosen").chosen();
	});
})(jQuery);
</script>

<div class="<?= $this->class ?> dewis block"<?= $this->cssID; ?> style="<?php if ($this->margin): ?><?= trim($this->margin) ?><?php endif; ?> <?php if ($this->style): ?><?= $this->style ?><?php endif; ?>">

	<?php if ($this->headline): ?>
		<<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
	<?php endif; ?>
	
	<?php $this->block('content'); ?>
	
		<div class="dewislinks noprint">
			<ul>
			<?php foreach($this->navigation as $d): ?>
				<?= $d ?>
			<?php endforeach; ?>
			</ul>
		</div>

		<?php if($this->subHeadline): ?>
			<h2><?= $this->subHeadline ?></h2>
		<?php endif; ?>

		<?php if($this->fehler): ?>

			<p class="error"><?= $this->fehler ?></p>

		<?php else: ?>

		<div class="table_responsiv">
			<table class="header">
				<tbody>
					<tr class="row_1">
						<td width="30%" class="col_1 label bottom-line">Code:</td>
						<td width="70%" class="col_2 value bottom-line"><?= $this->turnierheader['Turniercode'] ?></td>
					</tr>
					<tr class="row_2">
						<td class="col_1 label bottom-line">Auswerter:</td>
						<td class="col_2 value bottom-line"><?= $this->turnierheader['Auswerter1'] ?></td>
					</tr>
					<tr class="row_3">
						<td class="col_1 label bottom-line">Turnierende:</td>
						<td class="col_2 value bottom-line"><?= $this->turnierheader['Turnierende'] ?></td>
					</tr>
					<tr class="row_4">
						<td class="col_1 label bottom-line">Erste Berechnung am:</td>
						<td class="col_2 value bottom-line"><?= $this->turnierheader['Berechnet'] ?></td>
					</tr>
					<tr class="row_5">
						<td class="col_1 label bottom-line">Letzte Berechnung am:</td>
						<td class="col_2 value bottom-line"><?= $this->turnierheader['Nachberechnet'] ?></td>
					</tr>
					<tr class="row_6">
						<td class="col_1 label bottom-line">Spieler/Partien/Runden:</td>
						<td class="col_2 value bottom-line"><?= $this->turnierheader['Spieler'] ?> / <?= $this->turnierheader['Partien'] ?> / <?= $this->turnierheader['Runden'] ?></td>
					</tr>
					<tr class="row_7">
						<td class="col_1 label">Links:</td>
						<td class="col_2 value"><?= $this->turnierheader['Turnierauswertunglink'] ?></td>
					</tr>
				</tbody>
			</table>
		</div>

		<?php // Obere Scrollleiste (wird per JS mit der Tabelle synchronisiert) ?>
		<div class="table_responsiv_top noprint"><div class="table_responsiv_top_inner"></div></div>
		<div class="table_responsiv scrollsync">
			<?php if($this->istKreuztabelle): ?>

				<?php // Kreuztabelle (Rundenturnier): Zeilen und Spalten = Spieler ?>
				<table class="body kreuztabelle">
					<thead>
						<tr class="head">
							<th class="right-line">Nr.</th>
							<th class="">Spielername</th>
							<th class="right-line">&nbsp;</th>
							<th class="right-line">DWZ</th>
							<th class="right-line">Erg.</th>
							<?php foreach($this->spieler as $s): ?>
								<th class="kreuz-zelle right-line" title="<?= strip_tags($s['Spielername']) ?>"><?= $s['Nummer'] ?></th>
							<?php endforeach; ?>
						</tr>
					</thead>
					<tbody>
						<?php $x = 0; ?>
						<?php foreach($this->spieler as $d): ?>
							<?php $x++; $class = ($x < count($this->spieler)) ? ' bottom-line' : ''; ?>
							<tr>
								<td class="align-right right-line<?= $class ?>"><?= $d['Nummer'] ?></td>
								<td class="right-line<?= $class ?>"><?= $d['Spielername'] ?></td>
								<td class="right-line<?= $class ?>"><?= $d['Scoresheet'] ?></td>
								<td class="right-line<?= $class ?>"><?= $d['DWZ alt'] ?></td>
								<td class="right-line<?= $class ?>"><?= $d['Ergebnis'] ?></td>
								<?php foreach($this->spieler as $gegner): ?>
									<?php $j = $gegner['Nummer']; ?>
									<?php if($j == $d['Nummer']): ?>
										<td class="kreuz-zelle kreuz-diagonale right-line<?= $class ?>"></td>
									<?php else: ?>
										<td class="kreuz-zelle right-line<?= $class ?>">
											<?php if(!empty($d['Kreuz'][$j])): ?>
												<?php // Farbe der Partie: Weiß fett, Schwarz mit dunklem Ergebnis-Hintergrund ?>
												<?php foreach($d['Kreuz'][$j] as $erg): ?><span class="result kreuz-<?= $erg['Farbe'] ?>" title="mit <?= $erg['Farbe'] == 'w' ? 'Weiß' : 'Schwarz' ?>"><?= $erg['Resultat'] ?></span><?php endforeach; ?>
											<?php endif; ?>
										</td>
									<?php endif; ?>
								<?php endforeach; ?>
							</tr>
						<?php endforeach; ?>
					</tbody>
				</table>

			<?php else: ?>

				<?php // Standarddarstellung: eine Spalte je Runde ?>
				<table class="body">
					<thead>
						<tr class="head">
							<th class="right-line">Nr.</th>
							<th class="">Spielername</th>
							<th class="right-line">&nbsp;</th>
							<th class="right-line">DWZ</th>
							<th class="right-line">Erg.</th>
							<?php for($r=1; $r<=$this->turnierheader['Runden']; $r++): ?>
								<?php $class = ($r+1 <= $this->turnierheader['Runden']) ? 'right-line' : ''; ?>
								<th class="<?= $class ?>"><?= $r ?></th>
							<?php endfor; ?>
						</tr>
					</thead>
					<tbody>
						<?php $x = 0; ?>
						<?php if($this->spieler): ?>
							<?php foreach($this->spieler as $d): ?>
								<?php $x++; $class = ($x < count($this->spieler)) ? ' bottom-line' : ''; ?>
								<tr>
									<td class="align-right right-line<?= $class ?>"><?= $d['Nummer'] ?></td>
									<td class="right-line<?= $class ?>"><?= $d['Spielername'] ?></td>
									<td class="right-line<?= $class ?>"><?= $d['Scoresheet'] ?></td>
									<td class="right-line<?= $class ?>"><?= $d['DWZ alt'] ?></td>
									<td class="right-line<?= $class ?>"><?= $d['Ergebnis'] ?></td>
									<?php for($r = 1; $r <= $this->turnierheader['Runden']; $r++): ?>
										<td class="right-line<?= $class ?>">
										<?php if($d['Ergebnisse'][$r]): ?>
											<?php foreach($d['Ergebnisse'][$r] as $erg): ?>
											<div class="<?= $erg['Farbklasse'] ?>" title="<?= $erg['Gegnername'] ?>">
												<span class="result"><?= $erg['Resultat'] ?></span>
												<span class=""><?= $erg['Farbe'] ?></span>
												<span class="opponent"><?= $erg['Gegner'] ?></span>
											</div>
											<?php endforeach; ?>
										<?php endif; ?>
										</td>
									<?php endfor; ?>
								</tr>
							<?php endforeach; ?>
						<?php endif; ?>
					</tbody>
				</table>

			<?php endif; ?>
		</div>

		<script>
		(function()
		{
			// Obere Scrollleiste mit der Tabelle synchronisieren, damit auch
			// breite Kreuztabellen ohne Scrollen bis zum Seitenende bedienbar sind
			document.querySelectorAll('.dewis .table_responsiv.scrollsync').forEach(function(unten)
			{
				var oben = unten.previousElementSibling;
				if(!oben || !oben.classList.contains('table_responsiv_top')) return;
				var inner = oben.firstElementChild;
				var tabelle = unten.querySelector('table');
				if(!tabelle) return;

				function breite() { inner.style.width = tabelle.offsetWidth + 'px'; }
				breite();
				window.addEventListener('resize', breite);

				var sperre = false;
				oben.addEventListener('scroll', function() { if(sperre) return; sperre = true; unten.scrollLeft = oben.scrollLeft; sperre = false; });
				unten.addEventListener('scroll', function() { if(sperre) return; sperre = true; oben.scrollLeft = unten.scrollLeft; sperre = false; });
			});
		})();
		</script>

		<?php endif; ?>

	<?php $this->endblock(); ?>

</div>
