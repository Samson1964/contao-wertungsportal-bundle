<?php
/**
 * Backend-Template des Moduls „Statistik"
 * Zeigt die Abrufe der Schnittstellenfunktionen (API, Cache, örtlicher Bestand).
 */
?>
<div id="tl_buttons"></div>

<h2 class="sub_headline">Abrufstatistik Wertungsportal</h2>

<div class="tl_listing_container wp-stat">

	<div class="wp-stat-steuerung">
		<div class="wp-stat-gruppe">
			<span class="wp-stat-titel">Zeitraum</span>
			<?php foreach($this->zeitraumLinks as $l): ?>
				<a href="<?= $l['url'] ?>" class="wp-stat-knopf<?= $l['aktiv'] ? ' aktiv' : '' ?>"><?= $l['text'] ?></a>
			<?php endforeach; ?>
		</div>

		<div class="wp-stat-gruppe">
			<span class="wp-stat-titel">Raster</span>
			<?php foreach($this->rasterLinks as $l): ?>
				<a href="<?= $l['url'] ?>" class="wp-stat-knopf<?= $l['aktiv'] ? ' aktiv' : '' ?>"><?= $l['text'] ?></a>
			<?php endforeach; ?>
		</div>

		<div class="wp-stat-gruppe">
			<span class="wp-stat-titel">Auswahl</span>
			<a href="<?= $this->urlAlle ?>" class="wp-stat-knopf<?= $this->funktion ? '' : ' aktiv' ?>">Alle Funktionen</a>
			<?php if($this->funktion): ?>
				<span class="wp-stat-knopf aktiv"><?= $this->funktion ?></span>
			<?php endif; ?>
		</div>
	</div>

	<div class="wp-stat-navigation">
		<a href="<?= $this->urlZurueck ?>" class="wp-stat-knopf" title="Um einen Zeitraum zurück">&#9664;&nbsp;zurück</a>

		<span class="wp-stat-zeitraum">
			<strong><?= $this->von ?></strong> bis <strong><?= $this->bis ?></strong><?php if($this->funktion): ?>,
			<strong><?= $this->funktion ?></strong> <span class="wp-stat-pfad"><?= $this->endpunkt ?></span><?php endif; ?>
		</span>

		<?php if($this->kannVor): ?>
			<a href="<?= $this->urlVor ?>" class="wp-stat-knopf" title="Um einen Zeitraum vor">vor&nbsp;&#9654;</a>
			<a href="<?= $this->urlHeute ?>" class="wp-stat-knopf">bis heute</a>
		<?php else: ?>
			<span class="wp-stat-knopf gesperrt" aria-disabled="true">vor&nbsp;&#9654;</span>
		<?php endif; ?>
	</div>

	<?php if(!$this->hatDaten): ?>

		<p class="tl_info">
			Für diesen Zeitraum sind keine Abrufe gezählt.
			<?php if($this->erster): ?>
				Die Aufzeichnung beginnt am <?= $this->erster ?> — bitte einen längeren Zeitraum wählen
				oder mit „zurück“ bzw. „bis heute“ einen anderen Ausschnitt ansteuern.
			<?php else: ?>
				Die Zählung startet mit dem ersten Aufruf einer Wertungsportal-Seite im Frontend.
			<?php endif; ?>
		</p>

	<?php else: ?>

		<div class="wp-stat-diagramm">
			<div class="wp-stat-legende">
				<span><i style="background:<?= $this->farbeApi ?>"></i> von der API</span>
				<span><i style="background:<?= $this->farbeCache ?>"></i> aus dem lokalen Cache</span>
				<span><i style="background:<?= $this->farbeLokal ?>"></i> aus dem örtlichen Datenbestand</span>
			</div>
			<div class="wp-stat-scroll">
				<?= $this->diagramm ?>
			</div>
		</div>

		<div class="wp-stat-scroll">
		<table class="tl_listing wp-stat-tabelle">
			<thead>
				<tr>
					<th>Funktion</th>
					<th>Schnittstelle</th>
					<th class="rechts">von der API</th>
					<th class="rechts">aus dem Cache</th>
					<th class="rechts">örtlich</th>
					<th class="rechts">gesamt</th>
					<th class="rechts">ohne API</th>
				</tr>
			</thead>
			<tbody>
				<?php foreach($this->zeilen as $z): ?>
					<tr class="<?= $z['aktiv'] ? 'wp-stat-aktiv' : '' ?>">
						<td>
							<a href="<?= $z['url'] ?>" title="Nur diese Funktion anzeigen"><?= $z['funktion'] ?></a>
						</td>
						<td class="wp-stat-pfad"><?= $z['endpunkt'] ?></td>
						<td class="rechts"><?= number_format($z['api'], 0, ',', '.') ?></td>
						<td class="rechts"><?= number_format($z['cache'], 0, ',', '.') ?></td>
						<td class="rechts"><?= number_format($z['lokal'], 0, ',', '.') ?></td>
						<td class="rechts"><strong><?= number_format($z['gesamt'], 0, ',', '.') ?></strong></td>
						<td class="rechts"><?= $z['gesamt'] ? $z['quote'].' %' : '&ndash;' ?></td>
					</tr>
				<?php endforeach; ?>
			</tbody>
			<tfoot>
				<tr>
					<td colspan="2"><strong>Summe</strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['api'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['cache'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['lokal'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['gesamt'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= $this->gesamt['quote'] ?> %</strong></td>
				</tr>
			</tfoot>
		</table>
		</div>

		<p class="tl_help">
			Ein Klick auf eine Funktion zeigt deren Verlauf allein. „Aus dem Cache“ sind Aufrufe,
			die ohne Anfrage an das Wertungsportal beantwortet wurden; „örtlich“ solche, die aus
			den eigenen Tabellen kamen, weil die Schnittstelle abgeschaltet war oder nicht
			antwortete und auch der Cache nichts hergab. Die Spalte „ohne API“ nennt den Anteil
			beider zusammen — je höher er ist, desto weniger Last entsteht bei der Schnittstelle.
		</p>

	<?php endif; ?>

	<h3 class="wp-stat-ueberschrift">Vereinslisten-Schnittstelle</h3>

	<?php if(!$this->hatToken): ?>

		<p class="tl_info">Im gewählten Zeitraum wurde die Vereinslisten-Schnittstelle nicht aufgerufen.
			Die Zugangsschlüssel werden unter <a href="<?= $this->tokenUrl ?>">WP&nbsp;|&nbsp;Zugangsschlüssel</a> verwaltet.</p>

	<?php else: ?>

		<?php if(count($this->tokenZeilen)): ?>
			<div class="wp-stat-scroll">
			<table class="tl_listing wp-stat-tabelle">
				<thead>
					<tr>
						<th>Schlüssel</th>
						<th>Inhaber</th>
						<th>VKZ</th>
						<th class="rechts">Anfragen</th>
						<th class="rechts">davon erfolgreich</th>
						<th>letzte Anfrage</th>
					</tr>
				</thead>
				<tbody>
					<?php foreach($this->tokenZeilen as $z): ?>
						<tr>
							<td>
								<?php if($z['geloescht']): ?>
									<span class="wp-stat-geloescht">gelöschter Schlüssel</span>
								<?php else: ?>
									<a href="<?= $z['url'] ?>" title="Zugriffe dieses Schlüssels anzeigen"><?= $z['kurz'] ?>…</a><?php if($z['gesperrt']): ?> <span class="wp-stat-sperre">gesperrt</span><?php endif; ?>
								<?php endif; ?>
							</td>
							<td>
								<?php if($z['geloescht']): ?>
									<span class="tl_gray">Inhaber nicht mehr bekannt</span>
								<?php else: ?>
									<?= \Contao\StringUtil::specialchars($z['name']) ?> <span class="wp-stat-pfad"><?= \Contao\StringUtil::specialchars($z['email']) ?></span>
								<?php endif; ?>
							</td>
							<td><?= \Contao\StringUtil::specialchars($z['vkz']) ?></td>
							<td class="rechts"><strong><?= number_format($z['anzahl'], 0, ',', '.') ?></strong></td>
							<td class="rechts"><?= number_format($z['erfolge'], 0, ',', '.') ?></td>
							<td><?= $z['letzterText'] ?></td>
						</tr>
					<?php endforeach; ?>
				</tbody>
				<tfoot>
					<tr>
						<td colspan="3"><strong>Summe</strong></td>
						<td class="rechts"><strong><?= number_format($this->tokenGesamt['anzahl'], 0, ',', '.') ?></strong></td>
						<td class="rechts"><strong><?= number_format($this->tokenGesamt['erfolge'], 0, ',', '.') ?></strong></td>
						<td></td>
					</tr>
				</tfoot>
			</table>
			</div>
		<?php endif; ?>

		<?php if(count($this->tokenAbweisungen)): ?>
			<h4 class="wp-stat-ueberschrift">Abgewiesene Anfragen</h4>
			<div class="wp-stat-scroll">
			<table class="tl_listing wp-stat-tabelle">
				<thead>
					<tr>
						<th>IP-Adresse</th>
						<th class="rechts">Anfragen</th>
						<th>Gründe</th>
						<th>letzte Anfrage</th>
					</tr>
				</thead>
				<tbody>
					<?php foreach($this->tokenAbweisungen as $a): ?>
						<tr>
							<td><?= \Contao\StringUtil::specialchars($a['ip']) ?></td>
							<td class="rechts"><strong><?= number_format($a['anzahl'], 0, ',', '.') ?></strong></td>
							<td><?= \Contao\StringUtil::specialchars($a['gruendeText']) ?></td>
							<td><?= $a['letzterText'] ?></td>
						</tr>
					<?php endforeach; ?>
				</tbody>
			</table>
			</div>
			<p class="tl_help">
				Fällt eine Adresse mit vielen abgewiesenen Anfragen auf, läßt sie sich unter
				System&nbsp;&rarr;&nbsp;Einstellungen im Feld „Gesperrte IP-Adressen“ eintragen.
				Einzelne Schlüssel sperrt man dagegen am Datensatz unter
				<a href="<?= $this->tokenUrl ?>">WP&nbsp;|&nbsp;Zugangsschlüssel</a>.
			</p>
		<?php endif; ?>

	<?php endif; ?>

</div>
