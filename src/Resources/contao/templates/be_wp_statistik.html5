<?php
/**
 * Backend-Template des Moduls „Statistik"
 * Zeigt die Abrufe der Schnittstellenfunktionen (Cache und API).
 */
?>
<div id="tl_buttons"></div>

<h2 class="sub_headline">Abrufstatistik Wertungsportal</h2>

<div class="tl_listing_container wp-stat">

	<div class="wp-stat-steuerung">
		<div class="wp-stat-gruppe">
			<span class="wp-stat-titel">Zeitraum</span>
			<?php foreach($this->zeitraumLinks as $l): ?>
				<a href="<?= $l['url'] ?>" class="wp-stat-knopf<?= $l['aktiv'] ? ' aktiv' : '' ?>"><?= $l['text'] ?></a>
			<?php endforeach; ?>
		</div>

		<div class="wp-stat-gruppe">
			<span class="wp-stat-titel">Raster</span>
			<?php foreach($this->rasterLinks as $l): ?>
				<a href="<?= $l['url'] ?>" class="wp-stat-knopf<?= $l['aktiv'] ? ' aktiv' : '' ?>"><?= $l['text'] ?></a>
			<?php endforeach; ?>
		</div>

		<div class="wp-stat-gruppe">
			<span class="wp-stat-titel">Auswahl</span>
			<a href="<?= $this->urlAlle ?>" class="wp-stat-knopf<?= $this->funktion ? '' : ' aktiv' ?>">Alle Funktionen</a>
			<?php if($this->funktion): ?>
				<span class="wp-stat-knopf aktiv"><?= $this->funktion ?></span>
			<?php endif; ?>
		</div>
	</div>

	<div class="wp-stat-navigation">
		<a href="<?= $this->urlZurueck ?>" class="wp-stat-knopf" title="Um einen Zeitraum zurück">&#9664;&nbsp;zurück</a>

		<span class="wp-stat-zeitraum">
			<strong><?= $this->von ?></strong> bis <strong><?= $this->bis ?></strong><?php if($this->funktion): ?>,
			<strong><?= $this->funktion ?></strong> <span class="wp-stat-pfad"><?= $this->endpunkt ?></span><?php endif; ?>
		</span>

		<?php if($this->kannVor): ?>
			<a href="<?= $this->urlVor ?>" class="wp-stat-knopf" title="Um einen Zeitraum vor">vor&nbsp;&#9654;</a>
			<a href="<?= $this->urlHeute ?>" class="wp-stat-knopf">bis heute</a>
		<?php else: ?>
			<span class="wp-stat-knopf gesperrt" aria-disabled="true">vor&nbsp;&#9654;</span>
		<?php endif; ?>
	</div>

	<?php if(!$this->hatDaten): ?>

		<p class="tl_info">
			Für diesen Zeitraum sind keine Abrufe gezählt.
			<?php if($this->erster): ?>
				Die Aufzeichnung beginnt am <?= $this->erster ?> — bitte einen längeren Zeitraum wählen
				oder mit „zurück“ bzw. „bis heute“ einen anderen Ausschnitt ansteuern.
			<?php else: ?>
				Die Zählung startet mit dem ersten Aufruf einer Wertungsportal-Seite im Frontend.
			<?php endif; ?>
		</p>

	<?php else: ?>

		<div class="wp-stat-diagramm">
			<div class="wp-stat-legende">
				<span><i style="background:<?= $this->farbeApi ?>"></i> von der API</span>
				<span><i style="background:<?= $this->farbeCache ?>"></i> aus dem lokalen Cache</span>
			</div>
			<div class="wp-stat-scroll">
				<?= $this->diagramm ?>
			</div>
		</div>

		<table class="tl_listing wp-stat-tabelle">
			<thead>
				<tr>
					<th>Funktion</th>
					<th>Schnittstelle</th>
					<th class="rechts">von der API</th>
					<th class="rechts">aus dem Cache</th>
					<th class="rechts">gesamt</th>
					<th class="rechts">Cache-Anteil</th>
				</tr>
			</thead>
			<tbody>
				<?php foreach($this->zeilen as $z): ?>
					<tr class="<?= $z['aktiv'] ? 'wp-stat-aktiv' : '' ?>">
						<td>
							<a href="<?= $z['url'] ?>" title="Nur diese Funktion anzeigen"><?= $z['funktion'] ?></a>
						</td>
						<td class="wp-stat-pfad"><?= $z['endpunkt'] ?></td>
						<td class="rechts"><?= number_format($z['api'], 0, ',', '.') ?></td>
						<td class="rechts"><?= number_format($z['cache'], 0, ',', '.') ?></td>
						<td class="rechts"><strong><?= number_format($z['gesamt'], 0, ',', '.') ?></strong></td>
						<td class="rechts"><?= $z['gesamt'] ? $z['quote'].' %' : '&ndash;' ?></td>
					</tr>
				<?php endforeach; ?>
			</tbody>
			<tfoot>
				<tr>
					<td colspan="2"><strong>Summe</strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['api'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['cache'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= number_format($this->gesamt['gesamt'], 0, ',', '.') ?></strong></td>
					<td class="rechts"><strong><?= $this->gesamt['quote'] ?> %</strong></td>
				</tr>
			</tfoot>
		</table>

		<p class="tl_help">
			Ein Klick auf eine Funktion zeigt deren Verlauf allein. „Aus dem Cache“ sind Aufrufe,
			die ohne Anfrage an das Wertungsportal beantwortet wurden — je höher dieser Anteil,
			desto weniger Last entsteht bei der Schnittstelle.
		</p>

	<?php endif; ?>

</div>
