<?php if($this->daten): ?>
	<table class="header">
		<tbody>
			<tr>
				<td width="30%" class="label">Gefundene Spieler:</td>
				<td width="70%" class="value"><?= $this->anzahl ?></td>
			</tr>
		</tbody>
	</table>

	<?php if($this->lokal): ?>
		<p class="lokalhinweis">Die Suche des Wertungsportals findet nur Namen, die genau am Anfang übereinstimmen, und liefert dadurch unvollständige Ergebnisse. Deshalb wird zusätzlich der örtliche Datenbestand durchsucht. Zeilen mit der Quelle „Lokal" stammen von dort: DWZ und letzte Auswertung entsprechen dem zuletzt übernommenen Stand und können vom Wertungsportal abweichen (maximal 300 Treffer).</p>
	<?php endif; ?>

	<?php
		// Spaltensortierung (Initialisierung in wertungsportal_sort.js)
		$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/tablesorter.css';
		$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/jquery.tablesorter.min.js';
		$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/wertungsportal_sort.js';
	?>

	<table class="body tablesorter">
		<thead>
			<tr>
				<th class="right-line">Spielername</th>
				<?php if(!$this->Sperre): ?><th class="right-line" data-sort="woche">Letzte<br>Ausw.</th><?php endif; ?>
				<th class="right-line" data-sort="zahl">DWZ</th>
				<th class="right-line" data-sort="zahl">Elo</th>
				<th class="" data-sort="titel">Titel</th>
				<th class="">Verein</th>
				<th class="">Quelle</th>
			</tr>
		</thead>
		<tbody>
		<?php $x = 0; ?>
		<?php foreach($this->daten as $d): ?>
			<?php $x++; $class = ($x < count($this->daten)) ? ' bottom-line' : ''; ?>
			<tr>
				<td class="right-line<?= $class ?>"><?= $d['Spielername'] ?></td>
				<?php if(!$this->Sperre): ?><td class="right-line<?= $class ?>"><?= $d['KW'] ?></td><?php endif; ?>
				<td class="right-line<?= $class ?>"><?= $d['DWZ'] ?></td>
				<td class="right-line<?= $class ?>"><?= $d['Elo'] ?></td>
				<td class="<?= $class ?>"><?= $d['Titel'] ?></td>
				<td class="<?= $class ?>"><?= $d['Verein'] ?></td>
				<td class="<?= $class ?> wp-quelle-<?= strtolower($d['Quelle']) ?>"><?= $d['Quelle'] ?></td>
			</tr>
		<?php endforeach; ?>
		</tbody>
	</table>
<?php endif; ?>

<?php if($this->debugausgabe): ?>
<pre>
	<?php print_r($this->debugausgabe); ?>
</pre>
<?php endif; ?>

