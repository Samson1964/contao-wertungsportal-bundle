	$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/default.css';
?>

<div class="<?php echo $this->class; ?> dewis block"<?php echo $this->cssID; ?> style="<?php if ($this->margin): ?><?php echo trim($this->margin); ?><?php endif; ?> <?php if ($this->style): ?><?php echo $this->style; ?><?php endif; ?>">

	<?php if($this->headline): ?>
		<<?= $this->hl ?>><?= $this->headline ?></<?= $this->hl ?>>
	<?php endif; ?> 

	<div class="dewislinks noprint">
		<ul>
		<?php foreach($this->navigation as $d): ?>
			<?= $d ?>
		<?php endforeach; ?>
		</ul>
	</div>

	<?php if($this->searchform): ?>
		<div class="wp-suche noprint">
			<form action="<?= \Schachbulle\ContaoWertungsportalBundle\Helper\Helper::getSpielerseiteUrl() ?>.html" method="get">
				<div class="wp-suche-block wp-suche-block--offen">
					<div class="wp-suche-felder">
						<div class="wp-feld wp-feld--breit">
							<label class="wp-label" for="ctrl_search">Spielername</label>
							<input id="ctrl_search" type="text" class="tl_input_text wp-input" autofocus name="search" maxlength="30" placeholder="Name, Vorname oder nur Name" value="<?= $this->search ?>">
							<p class="wp-hilfe">Auch ein Namensanfang genügt, z.&nbsp;B. „Müll".</p>
						</div>
					</div>
					<?php if($this->fehler): ?>
						<p class="wp-fehler" role="alert"><?= $this->fehler ?></p>
					<?php endif; ?>
					<div class="wp-suche-aktionen">
						<button type="submit" class="tl_submit wp-button">Spieler suchen</button>
					</div>
				</div>
			</form>
		</div>
	<?php endif; ?>
	
	<?php if($this->subHeadline): ?>
		<<?= $this->shl ?>><?= $this->subHeadline ?></<?= $this->shl ?>>
	<?php endif; ?> 

	<?php if($this->searchresult): ?>
		<div class="searchresult">
			<?= $this->searchresult ?>
		</div>
	<?php endif; ?> 

	<?php if($this->sperre): ?>
		<div class="error">
		Sie müssen angemeldet sein, um Details des Spielers anschauen zu können!
		</div>
	<?php endif; ?> 

	<?php if($this->sichtbar): ?>

		<?php // Kopf als Flex-Layout: Bild links, Datentabelle rechts. So rutschen
		      // die Spalten auch bei vielen Vereinsmitgliedschaften nicht mehr unter
		      // das Spielerbild (früher rowspan="6" fest an der Bildzelle). ?>
		<div class="karteikarte-kopf">
			<?php if($this->addImage): ?>
				<div class="karteikarte-bild">
					<?php $this->insert('image', $this->arrData); ?>
					<br><a href="mailto:webmaster@schachbund.com" style="font-size:10px;">Foto senden</a>
				</div>
			<?php endif; ?>
			<div class="karteikarte-daten table_responsiv">
				<table class="header">
					<tbody>
						<tr class="row_0">
							<td class="col_1 bottom-line">Name:</td>
							<td class="col_2 value bottom-line" colspan="5"><?= $this->spielername ?></td>
						</tr>
						<tr class="row_dwz">
							<td class="col_1 bottom-line">Aktuelle DWZ:</td>
							<td class="col_2 value bottom-line"><?= $this->dwz ?></td>
							<td class="col_3 bottom-line">Geschlecht:</td>
							<td class="col_4 value bottom-line"><?= $this->geschlecht ?></td>
							<td class="col_5 bottom-line">Geburtsjahr:</td>
							<td class="col_6 value bottom-line"><?= $this->geburtsjahr ?></td>
						</tr>
						<?php $row = 1; ?>
						<?php if($this->vereine): ?>
							<?php $x = 0; ?>
							<?php foreach($this->vereine as $d): ?>
								<?php $x++; $class = ($x == count($this->vereine)) ? ' bottom-line' : ''; ?>
								<?php // Untere Linie wandert auf die Verband-Zeile, wenn eine folgt ?>
								<?php $vclass = !empty($d['verband']) ? '' : $class; ?>
								<tr class="row_<?= $row ?>">
									<td class="col_1<?= $vclass ?>">Verein:</td>
									<td class="col_2 value<?= $vclass ?>"><?= $d['name'] ?></td>
									<td class="col_3<?= $vclass ?>">ZPS-Nr.:</td>
									<td class="col_4 value<?= $vclass ?>"><?= $d['zps'] ?></td>
									<td class="col_5<?= $vclass ?>">Status:</td>
									<td class="col_6 value<?= $vclass ?>"><?= $d['status'] ?></td>
								</tr>
								<?php $row++; ?>
								<?php if(!empty($d['verband'])): ?>
									<tr class="row_<?= $row ?> verband">
										<td class="col_1<?= $class ?>">Verband:</td>
										<td class="col_2 col_3 col_4 col_5 col_6 value<?= $class ?>" colspan="5"><?= $d['verband'] ?></td>
									</tr>
									<?php $row++; ?>
								<?php endif; ?>
							<?php endforeach; ?>
						<?php endif; ?>
						<tr class="row_<?= $row ?>">
							<td class="col_1">FIDE-Elo:</td>
							<td class="col_2 value"><?= $this->elo ?></td>
							<td class="col_3">ID-Code:</td>
							<td class="col_4 value"><?= $this->fide_id ?></td>
							<td class="col_5">Titel:</td>
							<td class="col_6 value"><?= $this->fide_titel ?></td>
						</tr>
						<?php $row++; ?>
						<tr class="row_<?= $row ?> fide">
							<td class="col_1 bottom-line">&nbsp;</td>
							<td class="col_2 bottom-line">&nbsp;</td>
							<td class="col_3 bottom-line">Nation:</td>
							<td class="col_4 bottom-line value"><?= $this->fide_nation ?></td>
							<td class="col_5 bottom-line">&nbsp;</td>
							<td class="col_6 bottom-line">&nbsp;</td>
						</tr>
						<?php $row++; ?>
						<tr class="row_<?= $row ?> historie">
							<td class="col_1 bottom-line">Historie:</td>
							<td class="col_2 col_3 col_4 col_5 col_6 value bottom-line" colspan="5"><?= $this->historie ?></td>
						</tr>
						<?php $row++; ?>
						<tr class="row_<?= $row ?> referent">
							<td class="col_1 col_2" colspan="2">Zuständiger Wertungsreferent:</td>
							<td class="col_3 col_4 col_5 col_6 value" colspan="4"><?= $this->referent ?></td>
						</tr>
					</tbody>
				</table>
			</div>
		</div>

		<?php
			// tablesorter kommt seit 1.0.7 aus diesem Bundle (vorher contaodewis);
			// Initialisierung und Zahlenparser in wertungsportal_sort.js
			$GLOBALS['TL_CSS'][] = 'bundles/contaowertungsportal/css/tablesorter.css';
			$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/jquery.tablesorter.min.js';
			$GLOBALS['TL_JAVASCRIPT'][] = 'bundles/contaowertungsportal/js/wertungsportal_sort.js';
		?>

		<div class="table_responsiv">
			<table class="body tablesorter">
				<thead>
					<tr class="row_0">
						<th class="col_0 right-line" data-sort="zahl">Nr.</th>
						<th class="col_1 right-line" data-sort="zahl">Jahr</th>
						<th class="col_2 right-line">Turnier</th>
						<th class="col_3 right-line" data-sort="zahl">Pkt.</th>
						<th class="col_4 right-line" data-sort="zahl">Par.</th>
						<th class="col_5 right-line" data-sort="zahl">We</th>
						<th class="col_6 right-line" data-sort="zahl">E</th>
						<th class="col_7 right-line" data-sort="zahl">Gegn.</th>
						<th class="col_8 right-line" data-sort="zahl">Lstg.</th>
						<th class="col_9" data-sort="zahl">Akt. DWZ</th>
					</tr>
				</thead>
				<tbody>
					<?php $row = 1; ?>
					<?php if($this->altkartei): ?>
						<?php $x = 0; ?>
						<?php foreach($this->altkartei as $d): ?>
							<?php $x++; $class = ($x < count($this->altkartei)) ? ' bottom-line' : ''; ?>
							<tr class="row_<?= $row ?> elobase">
								<td class="col_0<?= $class ?> right-line"><?= $d['nummer'] ?></td>
								<td class="col_1<?= $class ?> right-line"><?= $d['jahr'] ?></td>
								<td class="col_2<?= $class ?> right-line"><?= $d['turnier'] ?></td>
								<td class="col_3<?= $class ?> right-line"><?= $d['punkte'] ?></td>
								<td class="col_4<?= $class ?> right-line"><?= $d['partien'] ?></td>
								<td class="col_5<?= $class ?> right-line"><?= $d['we'] ?></td>
								<td class="col_6<?= $class ?> right-line"><?= $d['e'] ?></td>
								<td class="col_7<?= $class ?> right-line"><?= $d['gegner'] ?></td>
								<td class="col_8<?= $class ?> right-line"><?= $d['leistung'] ?></td>
								<td class="col_9<?= $class ?>"><?= $d['dwz-neu'] ?></td>
							</tr>
							<?php $row++; ?>
						<?php endforeach; ?>
					<?php endif; ?>
					<?php if($this->kartei): ?>
						<?php $x = 0; ?>
						<?php foreach($this->kartei as $d): ?>
							<?php $x++; $class = ($x < count($this->kartei)) ? ' bottom-line' : ''; ?>
							<?php // DWZ-Umstufungen (typ=upgrade) farblich hervorheben ?>
							<tr class="row_<?= $row ?> <?= (isset($d['typ']) && $d['typ'] == 'upgrade') ? 'upgrade' : 'dewis' ?>">
								<td class="col_0<?= $class ?> right-line align-right"><?= $d['nummer'] ?></td>
								<td class="col_1<?= $class ?> right-line"><?= $d['jahr'] ?></td>
								<td class="col_2<?= $class ?> right-line"><?= $d['turnier'] ?></td>
								<td class="col_3<?= $class ?> right-line"><?= $d['punkte'] ?></td>
								<td class="col_4<?= $class ?> right-line"><?= $d['partien'] ?></td>
								<td class="col_5<?= $class ?> right-line"><?= $d['we'] ?></td>
								<td class="col_6<?= $class ?> right-line"><?= $d['e'] ?></td>
								<td class="col_7<?= $class ?> right-line"><?= $d['gegner'] ?></td>
								<td class="col_8<?= $class ?> right-line"><?= $d['leistung'] ?></td>
								<td class="col_9<?= $class ?>"><?= $d['dwz-neu'] ?></td>
							</tr>
							<?php $row++; ?>
						<?php endforeach; ?>
					<?php endif; ?>
				</tbody>
			</table>
		</div>

		<?php if($this->diagramm): ?>
			<div class="diagramm">
				<h3>DWZ und Leistung<?= $this->diagrammKomplett ? ' (letzte 50 Turniere)' : '' ?></h3>
				<?= $this->diagramm ?>
				<?php if($this->diagrammKomplett): ?>
					<p class="noprint"><a href="#" id="dwzDiagrammAlleLink">Diagramm mit allen Turnieren anzeigen</a></p>
					<div id="dwzDiagrammOverlay" class="dwz-diagramm-overlay">
						<div class="dwz-diagramm-overlay-inner">
							<a href="#" class="dwz-diagramm-schliessen" title="Schließen">&times;</a>
							<h3>DWZ und Leistung (alle Turniere)</h3>
							<div class="dwz-diagramm-scroll"><?= $this->diagrammKomplett ?></div>
						</div>
					</div>
					<script>
					(function()
					{
						var overlay = document.getElementById('dwzDiagrammOverlay');
						document.getElementById('dwzDiagrammAlleLink').addEventListener('click', function(e)
						{
							e.preventDefault();
							overlay.classList.add('offen');
						});
						overlay.addEventListener('click', function(e)
						{
							if(e.target === overlay || e.target.classList.contains('dwz-diagramm-schliessen'))
							{
								e.preventDefault();
								overlay.classList.remove('offen');
							}
						});
					})();
					</script>
				<?php endif; ?>
			</div>
		<?php endif; ?>

	<?php endif; ?>

	<?= $this->infobox ?>

<?php if($this->hinweis): ?>
	<?= $this->registrierung ?>
<?php endif; ?> 

</div>
