{#
 # DWZ-Archiv-Suche (ab 1.61.0), gerendert von DwzArchivSucheController.
 #
 # Formular per GET, damit Ergebnisse verlinkbar sind. Klassen von Bootstrap
 # (Theme dsb2026) für Felder, Knopf und Tabelle; das Übrige in
 # public/css/dwzarchiv.css. Der Ergebnisbereich ist eine aria-live-Region.
 #}
{% set feld = 'wp-dwzarchiv-' ~ id %}
<div class="mod_wertungsportal_dwzarchiv block wp-dwzarchiv{{ klasse ? ' ' ~ klasse }}"{% if cssId %} id="{{ cssId }}"{% endif %}>
    {% if ueberschrift %}<{{ ueberschrift.tag }}>{{ ueberschrift.text }}</{{ ueberschrift.tag }}>{% endif %}

    <form method="get" action="{{ aktion }}" class="wp-dwzarchiv-formular">
        <div class="wp-dwzarchiv-felder">
            <div class="wp-dwzarchiv-feld">
                <label for="{{ feld }}-datum" class="form-label">{{ t.datum }}</label>
                <input type="date" id="{{ feld }}-datum" name="datum" value="{{ datum }}"{% if min %} min="{{ min }}"{% endif %}{% if max %} max="{{ max }}"{% endif %} class="form-control" required>
            </div>
            {% if verbandswahl %}
                <div class="wp-dwzarchiv-feld">
                    <label for="{{ feld }}-verband" class="form-label">{{ t.verband }}</label>
                    <select id="{{ feld }}-verband" name="verband" class="form-select">
                        {% for code, name in verbaende %}
                            <option value="{{ code }}"{% if code ~ '' == verband %} selected{% endif %}>{{ name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            {% if formate|length > 1 %}
                <div class="wp-dwzarchiv-feld">
                    <label for="{{ feld }}-format" class="form-label">{{ t.format }}</label>
                    <select id="{{ feld }}-format" name="format" class="form-select">
                        <option value="">{{ t.alle }}</option>
                        {% for schluessel, name in formate %}
                            <option value="{{ schluessel }}"{% if schluessel == format %} selected{% endif %}>{{ name }}</option>
                        {% endfor %}
                    </select>
                </div>
            {% endif %}
            <div class="wp-dwzarchiv-feld">
                <button type="submit" class="btn btn-primary">{{ t.suchen }}</button>
            </div>
        </div>
    </form>

    <div class="wp-dwzarchiv-ergebnis" aria-live="polite">
        {% if ergebnis is empty %}
            <p class="wp-dwzarchiv-leer">{{ t.keine }}</p>
        {% else %}
            <p class="wp-dwzarchiv-kopf">{{ t.ergebnis|format(datum|date('d.m.Y')) }} – {{ verbandsname }}</p>
            {% for gruppe in ergebnis %}
                {{ _self.tabelle(gruppe, t, true) }}
            {% endfor %}
        {% endif %}
    </div>

    {% if neueste is not empty %}
        <div class="wp-dwzarchiv-neueste">
            <p class="wp-dwzarchiv-kopf">{{ t.neueste }}</p>
            {% for gruppe in neueste %}
                {{ _self.tabelle(gruppe, t, false) }}
            {% endfor %}
        </div>
    {% endif %}
</div>

{# Tabelle einer Formatgruppe; ohne Abstandsspalte bei den neuesten Dateien #}
{% macro tabelle(gruppe, t, mitAbstand) %}
    <div class="table-responsive">
        <table class="table table-sm wp-dwzarchiv-tabelle">
            <caption>{{ gruppe.titel }}</caption>
            <thead>
                <tr>
                    <th scope="col">{{ t.datei }}</th>
                    <th scope="col">{{ t.tag }}</th>
                    {% if mitAbstand %}<th scope="col">{{ t.abstand }}</th>{% endif %}
                    <th scope="col" class="wp-dwzarchiv-groesse">{{ t.groesse }}</th>
                    <th scope="col">{{ t.quelle }}</th>
                </tr>
            </thead>
            <tbody>
                {% for zeile in gruppe.zeilen %}
                    <tr>
                        <td><a href="{{ zeile.url }}" download>{{ zeile.name }}</a></td>
                        <td>{{ zeile.datum }}</td>
                        {% if mitAbstand %}<td>{{ zeile.abstand ?: t.genau }}</td>{% endif %}
                        <td class="wp-dwzarchiv-groesse">{{ zeile.groesse }}</td>
                        <td>{{ zeile.quelle }}</td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
{% endmacro %}
